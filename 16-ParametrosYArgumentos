// 16-ParametrosYArgumentos.js

// --- Declaración de funciones con y sin parámetros ---

// Función sin parámetros: No necesita información externa para realizar su tarea.
function saludar() {
  console.log('¡Hola!'); // Simplemente imprime un saludo fijo.
}

// Función con un parámetro: Necesita un texto para mostrarlo.
// 'texto' es el PARÁMETRO. Se declara en la definición de la función.
function mostrarTexto(texto) {
  console.log(texto); // Imprime el texto que recibe como parámetro.
}

// Función con múltiples parámetros: Necesita varios textos para mostrarlos.
// 'texto1', 'texto2', 'texto3' son los PARÁMETROS.
function mostrarMultiplesTextos(texto1, texto2, texto3) {
  console.log('Primer texto:', texto1);
  console.log('Segundo texto:', texto2);
  console.log('Tercer texto:', texto3);
}

// Función con un parámetro por defecto: Si no se envía un argumento, usa 'Texto por defecto'.
// 'texto' es el PARÁMETRO, y 'Texto por defecto' es su valor por defecto.
function mostrarTextoConDefecto(texto = 'Texto por defecto') {
  console.log(texto);
}

// --- Ejecución de las funciones (llamadas) ---

console.log('--- Llamadas a funciones ---');

// Llamada a la función 'saludar': No se envían argumentos porque no tiene parámetros.
saludar(); // Salida: ¡Hola!

// Llamada a la función 'mostrarTexto': Se envía un ARGUMENTO.
// 'Este es un texto dinámico' es el ARGUMENTO. Se envía durante la ejecución.
mostrarTexto('Este es un texto dinámico'); // Salida: Este es un texto dinámico

// Otra llamada a 'mostrarTexto' con un argumento diferente.
mostrarTexto('¡JavaScript es genial!'); //